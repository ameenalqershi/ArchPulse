{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ameenalqershi/ArchPulse/blob/main/docs/decisions/adr-v1.schema.json",
  "title": "ArchPulse Architecture Decision Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "status",
    "document",
    "source",
    "author",
    "dates",
    "affectedModules",
    "alternatives",
    "proposal",
    "reviewers",
    "approval",
    "supersededBy",
    "gates",
    "gateEvidence",
    "migration",
    "verification",
    "supersessionApproval"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^ADR-[0-9]{4}$"
    },
    "title": {
      "type": "string",
      "minLength": 8
    },
    "status": {
      "enum": [
        "Proposed",
        "Accepted",
        "Superseded"
      ]
    },
    "document": {
      "type": "string",
      "pattern": "^docs/decisions/ADR-[0-9]{4}-[a-z0-9-]+\\.md$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specification",
        "task",
        "notion"
      ],
      "properties": {
        "specification": {
          "type": "string",
          "pattern": "^S[0-9]{2}$"
        },
        "task": {
          "type": "string",
          "pattern": "^T[0-9]{3}$"
        },
        "notion": {
          "type": "string",
          "pattern": "^https://app\\.notion\\.com/p/"
        }
      }
    },
    "author": {
      "type": "string",
      "minLength": 3
    },
    "dates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposed",
        "accepted"
      ],
      "properties": {
        "proposed": {
          "type": "string",
          "format": "date"
        },
        "accepted": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "affectedModules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      },
      "uniqueItems": true
    },
    "alternatives": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "evidence",
          "tradeoffs",
          "mermaid"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]$"
          },
          "label": {
            "type": "string",
            "minLength": 3
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "tradeoffs": {
            "type": "string",
            "minLength": 8
          },
          "mermaid": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "proposal": {
      "type": "string",
      "minLength": 15
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "approval": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reviewUrl",
            "reviewer",
            "commitSha",
            "date",
            "decision"
          ],
          "properties": {
            "reviewUrl": {
              "type": "string",
              "pattern": "^https://github\\.com/[^/]+/[^/]+/pull/[0-9]+#pullrequestreview-[0-9]+$"
            },
            "reviewer": {
              "type": "string",
              "minLength": 1
            },
            "commitSha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "date": {
              "type": "string",
              "format": "date"
            },
            "decision": {
              "const": "Approved"
            }
          }
        }
      ]
    },
    "supersededBy": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^ADR-[0-9]{4}$"
        }
      ]
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "securityRequired",
        "privacyRequired",
        "contractRequired",
        "persistenceRequired"
      ],
      "properties": {
        "securityRequired": {
          "type": "boolean"
        },
        "privacyRequired": {
          "type": "boolean"
        },
        "contractRequired": {
          "type": "boolean"
        },
        "persistenceRequired": {
          "type": "boolean"
        }
      }
    },
    "gateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "security",
        "privacy",
        "contract",
        "persistence"
      ],
      "properties": {
        "security": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "privacy": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "contract": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "persistence": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forward",
        "rollback",
        "compatibility"
      ],
      "properties": {
        "forward": {
          "type": "string",
          "minLength": 10
        },
        "rollback": {
          "type": "string",
          "minLength": 10
        },
        "compatibility": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tests",
        "ciUrl",
        "graphImpact"
      ],
      "properties": {
        "tests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 4
          }
        },
        "ciUrl": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "uri"
            }
          ]
        },
        "graphImpact": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "supersessionApproval": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reviewUrl",
            "reviewer",
            "commitSha",
            "date",
            "decision"
          ],
          "properties": {
            "reviewUrl": {
              "type": "string",
              "pattern": "^https://github\\.com/[^/]+/[^/]+/pull/[0-9]+#pullrequestreview-[0-9]+$"
            },
            "reviewer": {
              "type": "string",
              "minLength": 1
            },
            "commitSha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "date": {
              "type": "string",
              "format": "date"
            },
            "decision": {
              "const": "Approved"
            }
          }
        }
      ]
    }
  }
}
